{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.1.0",
  "$id": "https://raw.githubusercontent.com/Libelium/-DataModels-CIM-Leziria-Do-Tejo/main/Gest%C3%A3o%20de%20Ocorr%C3%AAncias/schema/SurveyResponse.json",
  "modelTags": "CIMLT, PGU Lezíria do Tejo",
  "title": "SurveyResponse",
  "description": "Resposta de um cidadão a um inquérito de satisfação municipal. Pode ser identificada ou anónima.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:SurveyResponse:",
      "description": "Identificador da entidade: `urn:ngsi-ld:SurveyResponse:SR-<ano>-<número>`."
    },
    "type": {
      "type": "string",
      "enum": ["SurveyResponse"],
      "description": "Tipo de entidade NGSI-LD. Valor fixo `SurveyResponse`."
    },
    "survey": {
      "type": "string",
      "description": "Identificador do inquérito respondido (por exemplo `satisfaction-survey`).",
      "x-ngsi": {
        "type": "Property"
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["q", "value"],
        "properties": {
          "q": {
            "type": "string",
            "description": "Identificador da pergunta."
          },
          "value": {
            "type": "number",
            "description": "Valor numérico da resposta."
          }
        }
      },
      "description": "Respostas ao inquérito: uma entrada `{q, value}` por pergunta.",
      "x-ngsi": {
        "type": "Property"
      }
    },
    "anonymous": {
      "type": "boolean",
      "description": "`true` se a resposta é anónima (é o caso, salvo se o cidadão indicar nome ou endereço de correio eletrónico).",
      "x-ngsi": {
        "type": "Property"
      }
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do envio (ISO 8601, UTC).",
      "x-ngsi": {
        "type": "Property"
      }
    },
    "channel": {
      "type": "string",
      "description": "Canal de origem (por exemplo `citizen-app`).",
      "x-ngsi": {
        "type": "Property"
      }
    },
    "respondentName": {
      "type": "string",
      "description": "Nome do respondente, apenas se se identificar.",
      "x-ngsi": {
        "type": "Property"
      }
    },
    "respondentEmail": {
      "type": "string",
      "format": "email",
      "description": "Endereço de correio eletrónico do respondente, apenas se se identificar.",
      "x-ngsi": {
        "type": "Property"
      }
    }
  },
  "required": [
    "id",
    "type",
    "survey",
    "answers",
    "anonymous",
    "submittedAt",
    "channel"
  ]
}
